# ============================================================
#  GitLab CI Failure Analyzer  —  configuration
#  Copy this file to ".env" and fill in the 3 values marked TODO.
# ============================================================

# --- GitLab (READ-ONLY token) -------------------------------
# TODO: your GitLab base URL, e.g. https://gitlab.example.com
GITLAB_URL=
# TODO: a personal access token with scope "read_api" (read-only, cannot change anything)
GITLAB_TOKEN=

# Optional: limit to specific project IDs (comma-separated). Leave EMPTY to watch all repos you can access.
PROJECT_IDS=

# Optional: job names to ignore (comma-separated), e.g. noisy allow_failure jobs.
# Example: EXCLUDE_JOBS=sonarqube-check,lint
EXCLUDE_JOBS=

# Optional: also monitor these teammates' repos (GitLab user IDs, comma-separated).
# Tool watches the union of your repos + theirs. Example: TEAM_MEMBER_IDS=693,643,445
TEAM_MEMBER_IDS=

# --- Polling behaviour --------------------------------------
# How often to check GitLab (seconds). 180 = every 3 minutes.
POLL_INTERVAL_SECONDS=180
# 0 = scan ALL your repos every cycle (recommended, full coverage).
# >0 = only scan repos active within N hours (lighter, but can MISS failures).
ACTIVITY_WINDOW_HOURS=0

# --- AI -----------------------------------------------------
# true = get an AI explanation for each failure. false = skip the LLM and email
# the raw log tail only. Passwords/tokens/keys are masked before the log is sent.
AI_ENABLED=true
# ollama = local, logs never leave your network (default)
# groq   = cloud API, much faster; needs GROQ_API_KEY (free at console.groq.com)
AI_PROVIDER=ollama

# Ollama (used when AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Max seconds to wait for the AI (CPU models are slow).
OLLAMA_TIMEOUT=600

# Groq (used when AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=60

# --- Email (SMTP) -------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=you@example.com
# TODO: the password / app-password for the above mailbox
SMTP_PASSWORD=
SMTP_FROM=you@example.com
# Who receives the alerts (comma-separated). Can be one distribution list.
EMAIL_TO=dev-team@example.com

# --- Misc ---------------------------------------------------
# File used to remember the last check time & handled pipelines.
STATE_FILE=state.json
# Rotating log file (2 MB x 5).
LOG_FILE=ci_analyzer.log
# How much of the (end of the) log to send to the AI.
LOG_MAX_CHARS=12000
